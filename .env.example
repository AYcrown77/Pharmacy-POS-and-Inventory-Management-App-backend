# Mustan Healthcare Pharmacy — API
#
# Copy to `.env` and fill in the two blanks. `.env` is gitignored.
#
# You do not need to create the database by hand — `pnpm setup` creates it,
# builds the schema and seeds it. Just fill in DB_PASSWORD and SECRET_KEY below.
#
# Generate a SECRET_KEY with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mustan_pharmacy
DB_USER=postgres
DB_PASSWORD=

# Signs the session cookie. Any long random string; change it for production.
SECRET_KEY=

# How long a signed-in shift lasts before the cookie expires.
SESSION_EXPIRES_IN=12h
SESSION_COOKIE_NAME=mhp_session

# Origins allowed to send the session cookie during development.
CORS_ORIGINS=http://localhost:3000
